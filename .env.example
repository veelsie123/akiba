# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Demo & Development Flags (Optional)
# Set to "true" to display demo credentials on the login screen
NEXT_PUBLIC_DEMO_MODE=true
# Password hashing rounds for bcrypt (default: 6 in demo, recommend 10+ in production)
BCRYPT_SALT_ROUNDS=6
